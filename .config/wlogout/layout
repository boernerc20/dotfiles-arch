{
    "label": "lock",
    "action": "notify-send 'Lock disabled' 'Locking is disabled pending a fix — see conf.d/07-binds.conf'",
    "text": "Lock",
    "keybind": "l"
}

{
    "label": "logout",
    "action": "hyprctl dispatch exit",
    "text": "Logout",
    "keybind": "e"
}

{
    "label": "suspend",
    "action": "systemctl suspend",
    "text": "Suspend",
    "keybind": "u"
}

{
    "label": "shutdown",
    "action": "systemctl poweroff",
    "text": "Shutdown",
    "keybind": "s"
}

{
    "label": "hibernate",
    "action": "systemctl hibernate",
    "text": "Hibernate",
    "keybind": "h"
}

{
    "label": "reboot",
    "action": "systemctl reboot",
    "text": "Reboot",
    "keybind": "r"
}
