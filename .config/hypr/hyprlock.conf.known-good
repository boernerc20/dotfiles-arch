# hyprlock configuration — hyprlock v0.9.6
# Created 2026-07-28 after a lockout. SUPER+L was launching
#   hyprlock --config ~/.cache/wal/colors-hyprland.conf
# and that wal template contains `source = $HOME/.cache/wal/colors-hyprland.conf`
# — it sources ITSELF, which recurses in the Hyprlang parser.
#
# Deliberately minimal and self-contained: no `source` lines, only options
# verified to exist in 0.9.6, and literal colors. A broken or missing wal
# cache must never be able to lock you out of your own machine again.

general {
    hide_cursor = true
}

background {
    monitor =
    color = rgba(2, 0, 22, 1.0)
}

label {
    monitor =
    text = cmd[update:1000] echo "$(date +'%I:%M %p')"
    color = rgba(207, 209, 234, 1.0)
    font_size = 90
    font_family = JetBrainsMono Nerd Font
    position = 0, 160
    halign = center
    valign = center
}

# pam_usb runs first and unlocks with the USB key without typing.
# If the key is absent, this field takes your password.
input-field {
    monitor =
    size = 340, 55
    outline_thickness = 2
    dots_center = true
    outer_color = rgba(242, 171, 83, 1.0)
    inner_color = rgba(2, 0, 22, 0.85)
    font_color = rgba(207, 209, 234, 1.0)
    fade_on_empty = false
    placeholder_text = <i>Password or USB key...</i>
    position = 0, -40
    halign = center
    valign = center
}
