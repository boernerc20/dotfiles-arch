##############################################
# hyprland-local.conf — machine-specific overrides
# Copy to ~/.config/hypr/hyprland-local.conf
# DO NOT commit this file (it's in .gitignore)
##############################################

# ── MONITOR ──────────────────────────────────────────────────────────────────
# Run: hyprctl monitors   to find your display name and resolution

# Jarvis (NVIDIA ultrawide):
# monitor=DP-3, 3440x1440@120, 0x0, 1

# Friday (laptop) — check yours with: hyprctl monitors
# monitor=eDP-1, preferred, 0x0, 1.25

# ── GPU ENV VARS ─────────────────────────────────────────────────────────────
# Jarvis (NVIDIA discrete) — uncomment all:
# env = __GLX_VENDOR_LIBRARY_NAME,nvidia
# env = GBM_BACKEND,nvidia-drm
# env = __GL_GSYNC_ALLOWED,1
# env = __GL_VRR_ALLOWED,1

# Friday (Intel/AMD iGPU): no special vars needed

# ── JARVIS-ONLY SETTINGS ─────────────────────────────────────────────────────
# G-SYNC / VRR (jarvis only):
# misc {
#     vrr = 2
#     vfr = false
# }

# Tearing for G-SYNC (jarvis only):
# general {
#     allow_tearing = true
# }

# Xwayland scaling for ultrawide (jarvis only):
# xwayland {
#     force_zero_scaling = true
# }

# DPMS disable workaround (jarvis only, if needed):
# misc {
#     mouse_move_enables_dpms = false
#     key_press_enables_dpms = false
# }

# ── AUTOSTART (machine-specific) ─────────────────────────────────────────────
# Jarvis only (RGB):
# exec-once = openrgb -p DEFAULT
