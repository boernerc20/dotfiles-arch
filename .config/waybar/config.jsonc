{
  // ==========================================================================
  // waybar — sized for DP-3 (3440x1440, 34" ultrawide)
  // --------------------------------------------------------------------------
  // GLYPH WARNING. Every icon below is a Nerd Font Private Use Area character.
  // These bytes have been silently stripped once before — config.jsonc shipped
  // with `"format-icons": ["", "", ""]` (three EMPTY strings), which is why
  // the volume icon vanished and, worse, why the workspace indicator rendered
  // as blank buttons: format was "{icon}" and every icon resolved to "".
  //
  // If you edit this file with a tool that is not UTF-8 clean, re-run:
  //     ~/.config/waybar/scripts/verify-glyphs.py
  // which asserts every codepoint here actually exists in the installed font.
  //
  // Workspaces now use "{id}" — a real number, not a lookup. Even if a glyph
  // is lost again, the workspace indicator cannot go blank.
  // ==========================================================================

  "layer": "top",
  "position": "top",
  // 46, not 44: the module pills (6px margin + 17px icons) need 45px minimum,
  // and waybar silently grows the bar while logging a warning if asked for
  // less. Declaring the real height keeps config and render in agreement.
  "height": 46,
  "spacing": 6,
  "reload_style_on_change": true,

  // Spacious: one floating pill per module. There is plenty of horizontal
  // room on 3440px, so density is not the goal — the styling carries it.
  // mpris is the only variable-width module left, and it sits at the END of
  // modules-left so it grows rightward into empty space. In modules-center it
  // would re-center the group on every track change, making the workspace
  // numbers drift under the cursor.
  "modules-left": [
    "custom/distro",
    "custom/hardware",
    "disk",
    "pulseaudio",
    "mpris"
  ],
  "modules-center": [
    "hyprland/workspaces"
  ],
  "modules-right": [
    "privacy",
    "custom/updates",
    "custom/notification",
    "custom/cliphist",
    "custom/weather",
    "custom/network",
    "custom/network-bluetooth",
    "clock"
  ],

  // ── Workspaces ───────────────────────────────────────────────────────────
  // "{id}" prints the workspace NUMBER directly. The active one is styled as
  // an elongated filled pill (see style-base.css) so the current desktop is
  // unmistakable at a glance — the previous icon-dot version gave no such cue.
  "hyprland/workspaces": {
    "format": "{id}",
    "persistent-workspaces": {
      "*": [1, 2, 3, 4, 5]
    },
    "on-click": "activate",
    "on-scroll-up": "hyprctl dispatch workspace e+1",
    "on-scroll-down": "hyprctl dispatch workspace e-1"
  },

  "custom/distro": {
    "exec": "~/.config/waybar/scripts/distro_icon.sh",
    "format": "{}",
    "interval": 0,
    "tooltip": false,
    "on-click": "rofi -show drun -config ~/.config/rofi/colors-rofi.rasi"
  },

  "custom/hardware": {
    "exec": "~/.config/waybar/scripts/hardware.sh",
    "interval": 5,
    "format": "{}",
    "tooltip": false
  },

  "clock": {
    "format": "󰥔 {:%I:%M %p}",
    "format-alt": "󰃭 {:%a %b %d}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  },

  "custom/weather": {
    "exec": "~/.config/waybar/scripts/weather.sh",
    "interval": 600,
    "format": "{}",
    "tooltip": false
  },

  "custom/network-bluetooth": {
    "exec": "~/.config/waybar/scripts/network_bluetooth.sh",
    "interval": 10,
    "format": "{}",
    "tooltip": false,
    "on-click": "blueman-manager"
  },

  // ── Utility cluster (HyDE-inspired) ──────────────────────────────────────
  // No idle_inhibitor here on purpose: this machine does not auto-sleep or
  // lock, so a toggle for it would be a control with nothing to control.

  // Shows an indicator whenever something is capturing screen, mic or camera.
  "privacy": {
    "icon-spacing": 8,
    "icon-size": 15,
    "transition-duration": 200,
    "modules": [
      { "type": "screenshare", "tooltip": true },
      { "type": "audio-in", "tooltip": true }
    ]
  },

  // Same targets as the SUPER+V / SUPER+W keybinds, so bar and keyboard agree.
  "custom/cliphist": {
    "format": "󰅍",
    "tooltip": false,
    "on-click": "sleep 0.1 && cliphist list | rofi -dmenu -config ~/.config/rofi/colors-rofi.rasi -p 'clipboard' | cliphist decode | wl-copy"
  },

  // Wallpaper stays on SUPER+W only, and power on SUPER+X / SUPER+SHIFT+*.
  // Both were bar buttons duplicating a keybind that already gets used.

  // Pending package updates, official repos + AUR. Worth a widget because
  // updates here are deliberately manual (yay -Syu), so nothing else
  // surfaces that they are waiting.
  "custom/updates": {
    "exec": "~/.config/waybar/scripts/updates.sh",
    "return-type": "json",
    "interval": 1800,
    "on-click": "kitty --hold -e yay -Syu"
  },

  // mako do-not-disturb toggle plus unread count.
  "custom/notification": {
    "exec": "~/.config/waybar/scripts/notification.sh",
    "return-type": "json",
    "interval": 3,
    "on-click": "makoctl mode -t do-not-disturb",
    "on-click-right": "makoctl dismiss --all"
  },

  // Root filesystem free space.
  "disk": {
    "path": "/",
    "interval": 120,
    "format": "󰋊 {percentage_used}%",
    "tooltip-format": "{used} used of {total}  ({free} free)"
  },

  // No wlr/taskbar and no tray. The taskbar duplicated what the workspace
  // numbers and the windows themselves already show, and the tray existed
  // only to surface a Telegram icon that was never wanted. Removing the tray
  // means background apps have no bar presence at all — which is the intent.

  "mpris": {
    "format": "󰝚 {artist} - {title}",
    "format-paused": "󰏤 {artist} - {title}",
    "max-length": 45,
    "player": "spotify",
    "on-click": "playerctl -p spotify play-pause"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 muted",
    // Material Design (nf-md) codepoints on purpose. The Font Awesome volume
    // icons live at U+F025-F028, inside the BMP Private Use Area, which is the
    // exact range that got silently stripped before. The nf-md equivalents sit
    // above U+F0000 and survive; they also match the rest of the bar's icons.
    "format-icons": {
      "headphone": "󰋋",
      "headset": "󰋎",
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
  },

  // Traffic as a sparkline rather than digits. A numeric down/up readout was
  // a lot of glyphs for "is the network busy", and the figures churned every
  // tick even once the width was pinned.
  //
  // Continuous script: no "interval" key on purpose. waybar re-execs interval
  // scripts each tick, which would mean writing 14 samples of history to disk
  // and reading them back every second; this keeps history in memory instead.
  // restart-interval revives it if the process ever exits.
  "custom/network": {
    "exec": "~/.config/waybar/scripts/net-sparkline.py enp7s0",
    "return-type": "json",
    "restart-interval": 5,
    "on-click": "kitty --hold -e sh -c 'ip -br addr; echo; ss -tunp'"
  }
}
