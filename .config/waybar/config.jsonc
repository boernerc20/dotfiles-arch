{
  // Sized for DP-3: 3440x1440. The previous 40px/16px was 1080p sizing —
  // visibly chunky on a 1440p-tall panel. 34px/13px reads as the same
  // physical size at normal viewing distance and returns vertical space.
  "font": "JetBrainsMono Nerd Font:size=13",
  "height": 38,
  "spacing": 6,
  "reload_style_on_change": true,

  // Spacious layout: every module is its OWN floating pill, as in the
  // previous setup — there is plenty of horizontal room on 3440px, so
  // density is not the goal. Styling carries the character instead.
  "modules-left": [
    "custom/distro",
    "custom/hardware",
    "pulseaudio",
    "mpris"
  ],
  "modules-center": [
    "hyprland/workspaces"
  ],
  "modules-right": [
    "network",
    "custom/network-bluetooth",
    "custom/weather",
    "tray",
    "clock",
    "custom/power"
  ],

  "custom/distro": {
    "exec": "~/.config/waybar/scripts/distro_icon.sh",
    "format": "{}",
    "interval": 0,
    "tooltip": false
  },

  "custom/hardware": {
    "exec": "~/.config/waybar/scripts/hardware.sh",
    "interval": 5,
    "format": "{}",
    "tooltip": false
  },

  "clock": {
    "format": "󰥔 {:%I:%M %p}",
    "format-alt": "󰃭 {:%a %b %d}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  },

  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "active": "",
      "default": "",
      "empty": ""
    },
    "persistent-workspaces": {
      "*": [1, 2, 3, 4, 5]
    },
    "on-click": "activate"
  },

  "custom/weather": {
    "exec": "~/.config/waybar/scripts/weather.sh",
    "interval": 600,
    "format": "{}",
    "tooltip": false
  },

  "custom/network-bluetooth": {
    "exec": "~/.config/waybar/scripts/network_bluetooth.sh",
    "interval": 10,
    "format": "{}",
    "tooltip": false
  },

  // Power menu — same target as SUPER+X so the bar and the keybind agree.
  "custom/power": {
    "format": "⏻",
    "tooltip": false,
    "on-click": "pkill wlogout || wlogout"
  },

  // System tray. The old style.css styled #tray but no tray module was ever
  // declared in this config, so tray icons never appeared at all.
  "tray": {
    "icon-size": 16,
    "spacing": 10
  },

  "mpris": {
    "format": "󰝚 {artist} - {title}",
    "format-paused": "󰏤 {artist} - {title}",
    "max-length": 45,
    "player": "spotify",
    "on-click": "playerctl -p spotify play-pause"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 muted",
    "format-icons": ["", "", ""],
    "on-click": "pavucontrol",
    "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
  },

  "network": {
    "interface": "enp7s0",
    "interval": 2,
    "format-ethernet": " {bandwidthDownBytes}  {bandwidthUpBytes}",
    "tooltip-format-ethernet": "{ifname}\nDown: {bandwidthDownBytes}\nUp: {bandwidthUpBytes}",
    "format-disconnected": "󰈂 offline",
    "tooltip-format-disconnected": "No connection"
  }
}
