# Template for ~/.config/shell/secrets.env — COPY, DO NOT EDIT IN PLACE.
#
#     cp .config/shell/secrets.env.example ~/.config/shell/secrets.env
#     chmod 600 ~/.config/shell/secrets.env
#
# ~/.zshrc sources the real file if it exists, so a fresh machine works with
# these unset — the affected aliases simply fail rather than the shell breaking.
#
# WHY THIS FILE EXISTS
# --------------------
# Both values below were previously hardcoded in .zshrc_copy, which is tracked
# in this PUBLIC repo. They were readable by anyone from 2026-04-02 until
# 2026-08-02.
#
# The trap worth remembering: ~/.config/waybar/weather.env was already
# gitignored and mode 600, and it held the same OpenWeatherMap key. That
# protection counted for nothing because a second copy of the same value sat in
# a tracked file next to it. Gitignoring the canonical location does not help if
# the secret is also pasted somewhere else — audit by grepping for the VALUE
# across the whole tree, not by checking the file you expect it to live in.

# Home Assistant long-lived access token.
# Profile -> Security -> Long-Lived Access Tokens -> Create Token.
export HOME_ASSISTANT_TOKEN=""

# OpenWeatherMap API key — https://openweathermap.org/api_keys
# Used by the 'weather' alias (wego).
# waybar keeps its own copy in ~/.config/waybar/weather.env; if you rotate this
# key you must update BOTH files or the bar's weather module goes to its
# error glyph.
export OPENWEATHER_API_KEY=""
