/**
 * Rofi Theme: Wal‑Custom (with image)
 * Save this as ~/.config/wal/templates/colors-rofi-custom.rasi
 **/

/*****----- Configuration -----*****/
configuration {
    modi:                       "drun,run,filebrowser,window";
    show-icons:                 true;
    display-drun:               "APPS";
    display-run:                "RUN";
    display-filebrowser:        "FILES";
    display-window:             "WINDOW";
    drun-display-format:        "{name}";
    window-format:              "{w} · {c} · {t}";
}

/*****----- Global Properties -----*****/
* {
    font:                       "JetBrains Mono Nerd Font 10";
    background:                 {{background}};
    background-alt:             {{background}};
    foreground:                 {{foreground}};
    selected:                   {{color2}};
    active:                     {{color3}};
    urgent:                     {{color1}};
}

/*****----- Main Window -----*****/
window {
    transparency:               "real";
    location:                   center;
    anchor:                     center;
    fullscreen:                 false;
    width:                      1000px;
    x-offset:                   0px;
    y-offset:                   0px;

    enabled:                    true;
    border-radius:              15px;
    cursor:                     "default";
    background-color:           @background;
}

/*****----- Main Box -----*****/
mainbox {
    enabled:                    true;
    spacing:                    0px;
    background-color:           transparent;
    orientation:                horizontal;
    children:                   [ "imagebox", "listbox" ];
}

imagebox {
    padding:                    20px;
    background-color:           transparent;
    background-image:           url("~/.config/rofi/img/current.png", height);
    orientation:                vertical;
    children:                   [ "inputbar", "dummy", "mode-switcher" ];
}

listbox {
    spacing:                    20px;
    padding:                    20px;
    background-color:           transparent;
    orientation:                vertical;
    children:                   [ "message", "listview" ];
}

dummy {
    background-color:           transparent;
}

/*****----- Inputbar -----*****/
inputbar {
    enabled:                    true;
    spacing:                    10px;
    padding:                    15px;
    border-radius:              10px;
    background-color:           @background-alt;
    text-color:                 @foreground;
    children:                   [ "textbox-prompt-colon", "entry" ];
}

textbox-prompt-colon {
    enabled:                    true;
    expand:                     false;
    str:                        " ";
    background-color:           inherit;
    text-color:                 inherit;
}

entry {
    enabled:                    true;
    background-color:           inherit;
    text-color:                 inherit;
    cursor:                     text;
    placeholder:                "Search";
    placeholder-color:          inherit;
}

/*****----- Mode Switcher -----*****/
mode-switcher {
    enabled:                    true;
    spacing:                    20px;
    background-color:           transparent;
    text-color:                 @foreground;
}

button {
    padding:                    15px;
    border-radius:              10px;
    background-color:           @background-alt;
    text-color:                 inherit;
    cursor:                     pointer;
}

button selected {
    background-color:           @selected;
    text-color:                 @foreground;
}

/*****----- Listview -----*****/
/* scrollbar was `false` with lines: 8. Any list longer than 8 entries — the
   app menu, clipboard history, and the ~31 wallpapers — was silently cut off
   with NO on-screen indication that anything existed below the fold. A new
   wallpaper landing at sort position 9 simply looked like it had not been
   picked up at all. The list was always complete; you just could not see it.
   `dynamic: true` means short lists still shrink to fit, so the scrollbar
   only appears when there is genuinely something to scroll to. */
listview {
    enabled:                    true;
    columns:                    1;
    lines:                      8;
    cycle:                      true;
    dynamic:                    true;
    scrollbar:                  true;
    /* rofi's built-in default puts a 2px WHITE DASHED rule above the first
       row. The theme never asked for it, it is the one hardcoded colour in an
       otherwise fully palette-driven file, and it reads as a rendering fault
       rather than as a divider. Nothing inherits a border here, so 0 is safe. */
    border:                     0;
    layout:                     vertical;
    alternate-rows:             false;
    reverse:                    false;
    fixed-height:               true;
    fixed-columns:              true;
    spacing:                    10px;
    background-color:           transparent;
    text-color:                 @foreground;
    cursor:                     "default";
}

scrollbar {
    width:                      4px;
    border-radius:              4px;
    background-color:           @background-alt;
    handle-color:               {{color4}};
    handle-width:               4px;
}

/*****----- Elements -----*****/
element {
    enabled:                    true;
    spacing:                    15px;
    padding:                    8px;
    border-radius:              10px;
    background-color:           transparent;
    text-color:                 @foreground;
    cursor:                     pointer;
}

element normal.normal   { background-color: inherit;   text-color: inherit; }
element normal.urgent   { background-color: @urgent;  text-color: @foreground; }
element normal.active   { background-color: @active;  text-color: @foreground; }
element selected.normal { background-color: @selected;text-color: @foreground; }
element selected.urgent { background-color: @urgent;  text-color: @foreground; }
element selected.active { background-color: @active;  text-color: @foreground; }

element-icon {
    background-color:           transparent;
    text-color:                 inherit;
    size:                       32px;
    cursor:                     inherit;
}

element-text {
    background-color:           transparent;
    text-color:                 inherit;
    vertical-align:             0.5;
    horizontal-align:           0.0;
}

element.alternate.normal {
    background-color: @background;
    text-color:       @foreground;
}

element.alternate.urgent {
    background-color: @background;
    text-color:       @foreground;
}

element.alternate.active {
    background-color: @background;
    text-color:       @foreground;
}

/*****----- Message & Error -----*****/
message {
    background-color:           transparent;
    /* Same inherited 2px white dash as listview had. This one only surfaces
       when rofi actually has a message to show, so it is rarely seen — but it
       is the same defect and the same one-line fix. */
    border:                     0;
}

textbox {
    padding:                    15px;
    border-radius:              10px;
    background-color:           @background-alt;
    text-color:                 @foreground;
    vertical-align:             0.5;
    horizontal-align:           0.0;
}

error-message {
    padding:                    15px;
    border-radius:              20px;
    background-color:           @background;
    text-color:                 @foreground;
}
