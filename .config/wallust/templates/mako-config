# mako — GENERATED by wallust from ~/.config/wallust/templates/mako-config
# Do not edit directly; edit the template. Installed by ~/.local/bin/wal-hypr.sh,
# which then runs `makoctl reload` so running mako picks it up live.
#
# mako takes #RRGGBB or #RRGGBBAA, so colors use wallust's `strip` filter
# (hex with no leading '#') and append an alpha pair where wanted.

font=JetBrainsMono Nerd Font 11
background-color=#{{background | strip}}ee
text-color=#{{foreground | strip}}
border-color=#{{color4 | strip}}
progress-color=over #{{color2 | strip}}

width=380
height=140
margin=12
padding=14
border-size=2
border-radius=8

anchor=top-right
layer=overlay
default-timeout=6000
ignore-timeout=0
max-visible=5

[urgency=low]
border-color=#{{color8 | strip}}
text-color=#{{color7 | strip}}
default-timeout=4000

[urgency=normal]
border-color=#{{color4 | strip}}

# Critical notifications never auto-dismiss — the weekly diagnosis uses this
# urgency when a check FAILS, so it stays on screen until acknowledged.
[urgency=critical]
border-color=#{{color1 | strip}}
text-color=#{{foreground | strip}}
default-timeout=0
