#!/bin/bash
# wallust-switchover — cut this system over from pywal to wallust.
#
# pywal remains the ACTIVE theming engine until this script is run and
# succeeds. This script performs the cutover with full verification and
# automatic rollback: if anything looks wrong afterward, the system is put
# back exactly as it was before this script ran.
#
# Usage: wallust-switchover [/path/to/wallpaper]
#   Defaults to the currently active wallpaper ($HOME/.current_wallpaper).
set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

WALLUST_CONFIG="$HOME/.config/wallust/wallust.toml"
WAL_CACHE="$HOME/.cache/wal"
BACKUP_DIR="$HOME/.cache/wal.pywal-backup"
CONFIG_BACKUP_DIR="$BACKUP_DIR/config-backups"
AUTOSTART_CONF="$HOME/.config/hypr/conf.d/04-autostart.conf"
HYPRLOCK_LIVE_CONF="$HOME/.config/hypr/hyprlock.conf"

REQUIRED_OUTPUTS=(
    colors.json
    colors.sh
    colors-kitty.conf
    colors-waybar.css
    colors.css
    colors-rofi.rasi
    colors-rofi-power.rasi
    colors-rofi-dark.rasi
    hyprlock.conf
    config.cava
    yazi-theme.toml
    colors-qt6ct.conf
    colors-wal.vim
)

info()  { echo -e "${BLUE}==>${NC} $1"; }
warn()  { echo -e "${YELLOW}WARNING:${NC} $1"; }
fail()  { echo -e "${RED}FAILED:${NC} $1"; }
ok()    { echo -e "${GREEN}$1${NC}"; }

# ── Preflight ──────────────────────────────────────────────────────────
preflight() {
    if ! command -v wallust &>/dev/null; then
        fail "wallust is not installed / not on PATH."
        echo "Install it first with: yay -S wallust"
        exit 1
    fi

    if [ ! -f "$WALLUST_CONFIG" ]; then
        fail "$WALLUST_CONFIG not found."
        echo "Run the prep step that stages ~/.config/wallust/ before using this script."
        exit 1
    fi

    WALLPAPER="${1:-$(readlink -f "$HOME/.current_wallpaper")}"
    if [ -z "$WALLPAPER" ] || [ ! -f "$WALLPAPER" ]; then
        fail "Wallpaper file not found: '${WALLPAPER:-<empty>}'"
        echo "Pass an explicit wallpaper path, or ensure ~/.current_wallpaper resolves to a real file."
        exit 1
    fi

    info "Preflight OK. wallust: $(command -v wallust). Wallpaper: $WALLPAPER"
}

# ── Backup ───────────────────────────────────────────────────────────────
backup() {
    if [ -d "$BACKUP_DIR" ]; then
        warn "$BACKUP_DIR already exists — keeping the existing backup, not overwriting it."
        warn "(This is expected if wallust-switchover was already run before. If you want a fresh backup, remove that directory first — but only if you are SURE the current ~/.cache/wal/ is still valid pywal output.)"
        return
    fi

    info "Backing up $WAL_CACHE -> $BACKUP_DIR"
    cp -a "$WAL_CACHE" "$BACKUP_DIR"

    mkdir -p "$CONFIG_BACKUP_DIR"
    if [ -f "$AUTOSTART_CONF" ]; then
        cp -a "$AUTOSTART_CONF" "$CONFIG_BACKUP_DIR/04-autostart.conf"
    fi
    if [ -f "$HYPRLOCK_LIVE_CONF" ]; then
        cp -a "$HYPRLOCK_LIVE_CONF" "$CONFIG_BACKUP_DIR/hyprlock.conf"
    fi
    info "Backup complete."
}

# ── Rollback ───────────────────────────────────────────────────────────
rollback() {
    local reason="$1"
    fail "$reason"
    echo -e "${RED}Rolling back to the pywal-generated state...${NC}"

    if [ -d "$BACKUP_DIR" ]; then
        command rm -rf "$WAL_CACHE"
        cp -a "$BACKUP_DIR" "$WAL_CACHE"
        # Backup dir itself is nested (config-backups/ lives inside the copy
        # we just restored from); strip it back out of the live cache dir.
        command rm -rf "$WAL_CACHE/config-backups"

        if [ -f "$CONFIG_BACKUP_DIR/04-autostart.conf" ]; then
            cp -a "$CONFIG_BACKUP_DIR/04-autostart.conf" "$AUTOSTART_CONF"
        fi
        if [ -f "$CONFIG_BACKUP_DIR/hyprlock.conf" ]; then
            cp -a "$CONFIG_BACKUP_DIR/hyprlock.conf" "$HYPRLOCK_LIVE_CONF"
        fi
        echo -e "${RED}Rollback complete. System restored to its pre-switchover pywal state.${NC}"
    else
        echo -e "${RED}No backup directory found at $BACKUP_DIR — could not roll back automatically!${NC}"
        echo -e "${RED}pywal's cache in $WAL_CACHE may be in an inconsistent state. Re-run 'wal -i <wallpaper>' to regenerate it.${NC}"
    fi

    exit 1
}

# ── Run wallust ──────────────────────────────────────────────────────────
run_wallust() {
    info "Running: wallust run \"$WALLPAPER\""
    if ! wallust run "$WALLPAPER"; then
        rollback "wallust run exited non-zero."
    fi
}

# ── Verify ───────────────────────────────────────────────────────────────
verify() {
    info "Verifying rendered outputs in $WAL_CACHE ..."

    local f
    for f in "${REQUIRED_OUTPUTS[@]}"; do
        if [ ! -s "$WAL_CACHE/$f" ]; then
            rollback "$WAL_CACHE/$f is missing or empty."
        fi
    done
    ok "All ${#REQUIRED_OUTPUTS[@]} expected output files exist and are non-empty."

    local hyprlock_out="$WAL_CACHE/hyprlock.conf"

    if grep -qE '^[[:space:]]*source' "$hyprlock_out"; then
        rollback "$hyprlock_out contains a 'source' line — this is exactly the pattern that caused the 2026-07-28 lockout. Refusing to proceed."
    fi
    ok "$hyprlock_out has no 'source' line."

    if grep -qE 'color[[:space:]]*=[[:space:]]*#' "$hyprlock_out"; then
        rollback "$hyprlock_out has a bare 'color = #...' value. Hyprlang will reject this (\"cannot parse '' as an int\"). Colors must be rgb()/rgba()."
    fi
    ok "$hyprlock_out colors are rgb()/rgba()-wrapped, not bare hex."

    # ── The single most important check: does hyprlock itself accept this
    # config? A bad lock config can lock the user out, so this is not
    # optional.
    #
    # CRITICAL: this MUST run with the compositor environment stripped.
    # `hyprlock --config X` inside a live Wayland session does not merely
    # parse the file — it LOCKS THE SCREEN. Running it here unguarded would
    # trigger the very locker that is currently disabled for wedging the
    # session (see conf.d/07-binds.conf). With WAYLAND_DISPLAY and
    # HYPRLAND_INSTANCE_SIGNATURE removed, hyprlock parses the config, fails
    # to connect, and exits — which is exactly the validation we want.
    #
    # So "Couldn't connect to a wayland compositor" in the output is EXPECTED
    # and is not a failure. Only a line containing "Config error" is.
    info "Validating hyprlock config parses cleanly (compositor env stripped — will NOT lock) ..."
    local hyprlock_output
    hyprlock_output="$(env -u WAYLAND_DISPLAY -u HYPRLAND_INSTANCE_SIGNATURE -u XDG_SESSION_TYPE \
                       hyprlock --config "$hyprlock_out" 2>&1 || true)"
    if echo "$hyprlock_output" | grep -q "Config error"; then
        echo "$hyprlock_output"
        rollback "hyprlock reported a Config error against $hyprlock_out. This file must NEVER be installed as the real lock config — see rollback above."
    fi
    ok "hyprlock did not report a Config error (a 'couldn't connect to a wayland compositor' message here is expected and fine)."
}

# ── Repoint sequences consumer (success path only) ───────────────────────
repoint_sequences() {
    if [ ! -f "$AUTOSTART_CONF" ]; then
        warn "$AUTOSTART_CONF not found — skipping sequences repoint. You'll need to update it by hand."
        return
    fi

    if grep -q '~/.cache/wal/sequences' "$AUTOSTART_CONF"; then
        sed -i 's|~/\.cache/wal/sequences|~/.cache/wallust/sequences|' "$AUTOSTART_CONF"
        ok "Repointed $AUTOSTART_CONF to read ~/.cache/wallust/sequences."
    else
        warn "$AUTOSTART_CONF does not contain '~/.cache/wal/sequences' — nothing to repoint (already done, or line was changed)."
    fi
}

main() {
    preflight "$1"
    backup
    run_wallust
    verify
    repoint_sequences

    echo
    ok "=== wallust switchover complete ==="
    echo "What changed:"
    echo "  - wallust now renders theming into $WAL_CACHE (same filenames pywal used)."
    echo "  - $AUTOSTART_CONF now sources ~/.cache/wallust/sequences instead of"
    echo "    $WAL_CACHE/sequences on Hyprland startup."
    echo
    echo "Please verify by eye (this script cannot safely automate these checks):"
    echo "  - Wallpaper switch:  SUPER+CTRL+1 (or your usual bind) — confirm colors update everywhere."
    echo "  - Rofi:              SUPER+D — confirm it themes correctly."
    echo "  - Waybar / kitty / yazi / cava — confirm colors follow the new palette."
    echo
    echo "  NOTE: do NOT test the lock screen. Locking is DISABLED as of 2026-07-30 after a"
    echo "  second lockout (two hyprlock instances raced and wedged the session). SUPER+L is"
    echo "  unbound, hypridle does not autostart, and wlogout's lock action is neutralised."
    echo "  hyprlock.conf is still generated and parse-checked above so it is ready when"
    echo "  locking is eventually re-enabled behind a real flock mutex — but nothing should"
    echo "  launch hyprlock today. See ~/.config/hypr/conf.d/07-binds.conf."
    echo
    echo "A backup of the pre-switchover pywal state was kept at:"
    echo "  $BACKUP_DIR"
    echo "To fully revert to pywal by hand:"
    echo "  command rm -rf $WAL_CACHE"
    echo "  cp -a $BACKUP_DIR $WAL_CACHE && command rm -rf $WAL_CACHE/config-backups"
    echo "  cp -a $CONFIG_BACKUP_DIR/04-autostart.conf $AUTOSTART_CONF"
    echo "  cp -a $CONFIG_BACKUP_DIR/hyprlock.conf $HYPRLOCK_LIVE_CONF"
    echo "  yay -Rns wallust"
}

main "$@"
