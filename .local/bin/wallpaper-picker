#!/bin/bash
set -e

# Color codes for clarity
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# wallpaper-picker — rofi thumbnail picker over ~/pics/wallpapers, replacing
# the old hardcoded SUPER+CTRL+1..0 binds (only 10 of ~30 wallpapers reachable).
# Marks the currently-active wallpaper (~/.current_wallpaper symlink) with a
# leading marker. Applies the selection via wal-hypr.sh.
#
# Usage: wallpaper-picker [--random]

WALLPAPER_DIR="$HOME/pics/wallpapers"
ROFI_CONFIG="$HOME/.config/rofi/colors-rofi.rasi"
WAL_HYPR="/home/chris/.local/bin/wal-hypr.sh"
CURRENT_LINK="$HOME/.current_wallpaper"

list_wallpapers() {
    # Non-recursive; case-insensitive png/jpg/jpeg; skips upscale/ automatically
    # since maxdepth 1 never descends into subdirectories.
    find "$WALLPAPER_DIR" -maxdepth 1 -type f \( \
        -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' \
        \) | sort
}

# generate_menu <wallpapers> <current_real_path>
# Streams one dmenu entry per line directly to stdout: "NAME\0icon\x1f/path".
# Must NOT be captured via $(...) — bash command substitution strips embedded
# NUL bytes, which silently breaks rofi's icon syntax. Pipe it instead.
generate_menu() {
    local wallpapers=$1 current_real=$2
    local path name
    while IFS= read -r path; do
        name="$(basename "$path")"
        name="${name%.*}"
        if [[ -n "$current_real" && "$path" == "$current_real" ]]; then
            name="● $name"
        fi
        printf '%s\0icon\x1f%s\n' "$name" "$path"
    done <<< "$wallpapers"
}

apply_wallpaper() {
    local path=$1
    "$WAL_HYPR" "$path"
}

main() {
    if [[ ! -d "$WALLPAPER_DIR" ]]; then
        echo -e "${RED}Error: wallpaper directory not found: $WALLPAPER_DIR${NC}" >&2
        exit 1
    fi

    local wallpapers
    wallpapers="$(list_wallpapers)"

    if [[ -z "$wallpapers" ]]; then
        echo -e "${RED}Error: no wallpapers found in $WALLPAPER_DIR${NC}" >&2
        exit 1
    fi

    if [[ "${1:-}" == "--random" ]]; then
        local chosen
        chosen="$(echo "$wallpapers" | shuf -n 1)"
        apply_wallpaper "$chosen"
        exit 0
    fi

    local current_real=""
    if [[ -L "$CURRENT_LINK" ]]; then
        current_real="$(readlink -f "$CURRENT_LINK")"
    fi

    # Picker-only theme overrides, layered on top of the shared wallust rasi.
    #
    # A 32px thumbnail of a 3440x1440 wallpaper is an unreadable smudge, so the
    # shared theme's icon size makes -show-icons pointless here. But trading
    # rows for pixels has to be done as a PAIR, because rofi's row pitch is
    #     icon_size + 16 (element padding x2) + 10 (listview spacing)
    # so the icon size drives the window height directly. 12 rows at 96px is a
    # 1454px-tall panel — taller than this 1440px display, which clipped the
    # bottom entry off the screen entirely.
    #
    # 6 rows at 56px keeps the panel at ~531px against the app menu's ~500px:
    # near-identical height, thumbnails 75% larger, and with the scrollbar now
    # on there is a visible cue that the list continues.
    #
    # These go through -theme-str rather than into the template because the same
    # rasi drives SUPER+D (drun) and SUPER+V (cliphist), where 56px icons would
    # be oversized. One themed rasi, one documented exception to it.
    local theme_str='listview { lines: 6; } element-icon { size: 56px; }'

    local selection
    selection="$(generate_menu "$wallpapers" "$current_real" \
        | rofi -dmenu -show-icons -config "$ROFI_CONFIG" -theme-str "$theme_str" -p "wallpaper")"

    if [[ -z "$selection" ]]; then
        exit 0
    fi

    # Strip the active marker before resolving back to a path.
    selection="${selection#● }"

    local chosen=""
    local path name
    while IFS= read -r path; do
        name="$(basename "$path")"
        name="${name%.*}"
        if [[ "$name" == "$selection" ]]; then
            chosen="$path"
            break
        fi
    done <<< "$wallpapers"

    if [[ -z "$chosen" ]]; then
        echo -e "${RED}Error: could not resolve selection to a wallpaper file${NC}" >&2
        exit 1
    fi

    apply_wallpaper "$chosen"
}

main "$@"
