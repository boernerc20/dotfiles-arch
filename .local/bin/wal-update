#!/bin/bash
set -e

# Color codes
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m'

# Check if arguments were passed
if [[ $# -eq 0 ]]; then
    echo -e "${RED}Error: No arguments provided${NC}"
    echo -e "Usage: wal-update -i /path/to/wallpaper [additional wal options]"
    exit 1
fi

echo -e "${BLUE}Running pywal...${NC}"
wal "$@"

if [[ $? -eq 0 ]]; then
    echo -e "${GREEN}Pywal colors generated successfully${NC}"
    echo -e "${GREEN}Theme update complete!${NC}"
else
    echo -e "${RED}Pywal failed to generate colors${NC}"
    exit 1
fi
