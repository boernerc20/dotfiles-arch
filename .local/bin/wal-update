#!/bin/bash
set -e

# Color codes
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m'

# Check if arguments were passed
if [[ $# -eq 0 ]]; then
    echo -e "${RED}Error: No arguments provided${NC}"
    echo -e "Usage: wal-update -i /path/to/wallpaper [additional wal options]"
    exit 1
fi

echo -e "${BLUE}Running pywal...${NC}"
# Run wal with all provided arguments
wal "$@"

# Check if wal succeeded
if [[ $? -eq 0 ]]; then
    echo -e "${GREEN}Pywal colors generated successfully${NC}"

    # Reload other applications (add your existing reload commands here)
    # Example:
    # pkill -USR1 waybar 2>/dev/null || true
    # hyprctl reload 2>/dev/null || true

    echo -e "${GREEN}Theme update complete!${NC}"
else
    echo -e "${RED}Pywal failed to generate colors${NC}"
    exit 1
fi
