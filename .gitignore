.config/waybar/style.css
.config/waybar/style-backup.css

# Spicetify marketplace (large, auto-installs)
.config/spicetify/CustomApps/

# Sensitive files - DO NOT COMMIT
*.key
*.pem
*.env
.env.*
credentials.json
secrets.json

# System-specific files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Cache directories
__pycache__/
*.pyc
.cache/

