# Claude Code settings (local development)
.claude/

# Machine-specific local overrides (not shared between machines)
.config/hypr/hyprland-local.conf
.zshrc.local

# ── Generated by the theming pipeline ────────────────────────────────────────
# Everything here is rewritten by ~/.local/bin/wal-hypr.sh (or ~/.config/wal/
# postrun) on EVERY wallpaper change. Tracking them meant a single SUPER+W
# dirtied ~66 files, which buried real edits in the diff. The tracked sources
# that produce them are .config/wallust/templates/ and .config/wal/postrun —
# those are what actually need version control.
#
# NOTE: adding a path here does not untrack a file that is already committed.
# These required `git rm --cached` as well; do the same for anything new.
.config/neofetch/frames_colour/
.config/waybar/style.css
.config/waybar/style-backup.css
.config/gtk-3.0/gtk.css
.config/gtk-4.0/gtk.css
.config/rofi/colors-rofi.rasi
.config/hypr/hyprlock.conf
.config/cava/config

# frames_src is the INPUT to recolor_from_wal.py, not an output — it must stay
# tracked or a fresh clone has nothing to recolour. It was previously ignored
# here by mistake; the files survived only because they had been committed
# before the rule was added.

# GTK2 — auto-generated by nwg-look, contains hardcoded home path
.gtkrc-2.0

# Sensitive files - DO NOT COMMIT
*.key
*.pem
*.env
.env.*
credentials.json
secrets.json

# System-specific files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Cache directories
__pycache__/
*.pyc
.cache/

# Personal notes and temporary files
TODO.md
NOTES.md
scratch/

# Wallpapers are personal and large (60MB+). install.sh degrades gracefully
# when this directory is absent — see its "Generating initial colours" step,
# which warns and tells you to run wal-hypr.sh once you have supplied one.
wallpapers/
