#Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# ── Basic Settings ──────────────────────────────────────────────────────────
HISTFILE=~/.histfile
HISTSIZE=1000
SAVEHIST=1000
bindkey -e

# completion
autoload -Uz compinit
compinit

# Default Editor
export EDITOR=nvim

# ── NVIDIA GPU Settings ─────────────────────────────────────────────────────
# Intentionally empty. Compositor environment now lives in ONE place:
# ~/.config/hypr/hyprland.conf (the `env = ...` lines). Setting these in .zshrc
# duplicated them and applied them to every shell, not just the session.
#
# WLR_NO_HARDWARE_CURSORS was also removed here: it is obsolete for nvidia >= 555
# (this system runs 610.43.03) and forced slower software cursor rendering.

# Hook Pywal shell vars (if you use them very early)
[[ -f ~/.cache/wal/colors.sh ]] && source ~/.cache/wal/colors.sh

# ── Aliases ─────────────────────────────────────────────────────────────────
alias binds='micro ~/.config/hypr/conf.d/07-binds.conf'
alias ls='ls -a'
alias ll='ls -l'
alias clock='tty-clock -c -C 4 -t'
alias pipes='pipes.sh'
alias reload-grub='~/.local/bin/reload-grub.sh'
alias public-ip='curl -4 ifconfig.me'
alias cpp='rsync -ah --progress'
alias nas-media='sudo mount -t cifs //192.168.1.20/media /mnt/nas-media -o uid=1000,gid=1000,vers=3.0,credentials=/etc/nas-credentials'
alias unas-media='sudo umount /mnt/nas-media'
alias nas-back='sudo mount -t cifs //192.168.1.20/backups /mnt/nas-back -o uid=1000,gid=1000,vers=3.0,credentials=/etc/nas-credentials'
alias unas-back='sudo umount /mnt/nas-back'
alias nas-jarvis='sudo mount -t cifs //192.168.1.20/jarvis /mnt/jarvis -o uid=1000,gid=1000,vers=3.0,credentials=/etc/nas-credentials'
alias unas-jarvis='sudo umount /mnt/jarvis'
alias rm='trash-put'
# ani-v2.sh, not animated-neofetch.sh — v2 additionally recolors the frames from
# the current wal/wallust palette, so the animation follows the wallpaper. The
# older script is kept only as a fallback and does no recoloring.
alias neo='~/.config/neofetch/ani-v2.sh'
alias master='sudo cat /lockbox/pass/master'
alias rgb-default='openrgb -p DEFAULT'
alias rgb-off='openrgb -p OFF'
alias cmds='micro ~/projects/linux/03-configuration/cmds'
alias shrink-video='~/projects/linux/04-utilities/shrink-video'
alias cui='source /mnt/ai/comfy/comfy-low/bin/activate && python /mnt/ai/comfy/ComfyUI/main.py --listen 0.0.0.0 --port 8188 --enable-cors-header --preview-method taesd'
alias cui-low='source /mnt/ai/comfy/comfy-low/bin/activate && python /mnt/ai/comfy/ComfyUI/main.py --listen 0.0.0.0 --port 8188 --enable-cors-header --preview-method taesd --lowvram'
alias gotop='gotop --nvidia -s -a -p'
alias weather='wego -owm-api-key "$OPENWEATHER_API_KEY" -l "Falls+Church" -d 1 -u imperial'
alias mp4-gif='/home/chris/projects/linux/04-utilities/mp4-to-gif'
alias rpi-imager='sudo -E rpi-imager'
alias ai='cd /mnt/ai/'
alias venv='source venv/bin/activate'
alias ccm='ccm --plan pro'
alias drives='df -h | grep mnt'

# dotfiles-sync — pull the latest dotfiles on THIS machine and redeploy.
# git pull alone is not enough: install.sh is what actually copies tracked
# .config/ entries into place, picks the desktop-vs-laptop waybar layout via
# chassis, and installs any package the pull's commits newly depend on. Safe
# to re-run any time — every step it takes is idempotent (see its own header).
alias dotfiles-sync='cd ~/projects/dotfiles-arch && git pull origin main && ./install.sh'

# ── Yazi Integration ────────────────────────────────────────────────────────
# Wrapper function to change directory on exit
function yy() {
    local tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
    yazi "$@" --cwd-file="$tmp"
    if cwd="$(cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
        cd -- "$cwd"
    fi
    rm -f -- "$tmp"
}
# Quick alias for yazi
alias fm='yy'

# ── PowerLevel10k Setup ─────-─────────────────────────────────────────────────
source /usr/share/zsh-theme-powerlevel10k/powerlevel10k.zsh-theme
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# ── SSH agent ───────────────────────────────────────────────────────────────
# The agent is provided by the systemd USER unit `ssh-agent.socket`; it is
# deliberately NOT spawned here. Changed 2026-07-31.
#
# The old block was:
#     if ! pgrep -u "$USER" ssh-agent > /dev/null; then
#       eval "$(ssh-agent -s)" > /dev/null 2>&1
#     fi
# In an SSH login that put ssh-agent inside session-N.scope, where it OUTLIVED
# the connection and pinned that logind session open in State=closing forever.
# pam_usb can't resolve a tty under Wayland, so it falls back to asking logind
# whether the user has a remote session -- one stale entry makes it deny
# USB-key sudo permanently, with a bare "Access denied" and no explanation.
# See the header comment in /etc/security/pam_usb.conf.
#
# A systemd user unit runs in app.slice, so it can never pin a login session.
export SSH_AUTH_SOCK="${XDG_RUNTIME_DIR}/ssh-agent.socket"

# Load the key once, only if the agent is reachable and it isn't loaded yet.
if [[ -S "$SSH_AUTH_SOCK" ]] && ! ssh-add -l &>/dev/null; then
  ssh-add -q ~/.ssh/id_ed25519 2>/dev/null
fi

# Python 3.10 with PIP Setup
export PATH=$PATH:/opt/android-sdk/platform-tools
export PYENV_ROOT="$HOME/.pyenv"
command -v pyenv >/dev/null || export PATH="$PYENV_ROOT/bin:$PATH"
eval "$(pyenv init -)"



fpath+=~/.zfunc; autoload -Uz compinit; compinit

zstyle ':completion:*' menu select

. "$HOME/.local/bin/env"

# opencode
export PATH=/home/chris/.opencode/bin:$PATH

export PATH=$PATH:/home/chris/.spicetify

# bun completions
[ -s "/home/chris/.bun/_bun" ] && source "/home/chris/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
# Secrets live in ~/.config/shell/secrets.env (gitignored, mode 600).
# Never hardcode them here — this file is committed to a PUBLIC repo.
[[ -f ~/.config/shell/secrets.env ]] && source ~/.config/shell/secrets.env
export TERM=xterm-256color
# user npm global binaries
export PATH="$HOME/.npm-global/bin:$HOME/.local/bin:$PATH"
