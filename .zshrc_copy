#Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# ── Basic Settings ──────────────────────────────────────────────────────────
HISTFILE=~/.histfile
HISTSIZE=1000
SAVEHIST=1000
bindkey -e

# completion
autoload -Uz compinit
compinit

# Default Editor
export EDITOR=nvim

# ── Machine-Specific GPU Settings ───────────────────────────────────────────
# Loaded from ~/.zshrc.local (not tracked in dotfiles)
# Jarvis (NVIDIA): export __GLX_VENDOR_LIBRARY_NAME=nvidia etc.
# Friday (laptop): check GPU and set accordingly
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local

# Hook Pywal shell vars (if you use them very early)
[[ -f ~/.cache/wal/colors.sh ]] && source ~/.cache/wal/colors.sh

# ── Aliases ─────────────────────────────────────────────────────────────────
alias config='nvim ~/.config/hypr/hyprland.conf'
alias ls='ls -a'
alias ll='ls -l'
alias clock='tty-clock -c -C 4 -t'
alias pipes='pipes.sh'
alias public-ip='curl -4 ifconfig.me'
alias cpp='rsync -ah --progress'
alias rm='trash-put'
alias neo='~/.config/neofetch/animated-neofetch.sh'
alias gotop='gotop -s -a -p'
alias venv='source venv/bin/activate'
alias ccm='ccm --plan pro'

# ── Yazi Integration ────────────────────────────────────────────────────────
# Wrapper function to change directory on exit
function yy() {
    local tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
    yazi "$@" --cwd-file="$tmp"
    if cwd="$(cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
        cd -- "$cwd"
    fi
    rm -f -- "$tmp"
}
# Quick alias for yazi
alias fm='yy'

# ── PowerLevel10k Setup ─────-─────────────────────────────────────────────────
# Try common install locations (differs between pacman and AUR)
for _p10k_path in \
    /usr/share/zsh-theme-powerlevel10k/powerlevel10k.zsh-theme \
    /usr/share/powerlevel10k/powerlevel10k.zsh-theme \
    ~/.local/share/powerlevel10k/powerlevel10k.zsh-theme \
    ~/powerlevel10k/powerlevel10k.zsh-theme; do
    [[ -f "$_p10k_path" ]] && { source "$_p10k_path"; break; }
done
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# Start ssh-agent if not already running
if ! pgrep -u "$USER" ssh-agent > /dev/null; then
  eval "$(ssh-agent -s)" > /dev/null 2>&1
fi

# Add SSH key silently
ssh-add -q ~/.ssh/id_ed25519 2>/dev/null

# pyenv (only load if installed)
export PYENV_ROOT="$HOME/.pyenv"
if [[ -d "$PYENV_ROOT" ]]; then
    export PATH="$PYENV_ROOT/bin:$PATH"
    eval "$(pyenv init -)"
fi

fpath+=~/.zfunc; autoload -Uz compinit; compinit

zstyle ':completion:*' menu select

# uv env (only load if present)
[[ -f "$HOME/.local/bin/env" ]] && . "$HOME/.local/bin/env"

# opencode
export PATH=$HOME/.opencode/bin:$PATH

export PATH=$PATH:$HOME/.spicetify

# bun completions
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
# Machine-specific env vars (tokens, GPU settings, etc.)
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local
